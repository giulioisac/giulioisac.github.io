{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/bootstrap-claude-config.sh"
          },
          {
            "type": "command",
            "command": "pip install --quiet -r \"$CLAUDE_PROJECT_DIR\"/requirements.txt 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
